{
  "name": "xtbloom-web",
  "private": true,
  "type": "module",
  "description": "Build-time browser dependencies for the xtbloom WASM web demo (GitHub Pages deployment).",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "browser:install": "playwright install --with-deps chromium webkit",
