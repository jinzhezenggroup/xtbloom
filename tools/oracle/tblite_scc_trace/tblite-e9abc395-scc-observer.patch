+! GNU Lesser General Public License for more details.
+!
+! You should have received a copy of the GNU Lesser General Public License
+! along with tblite.  If not, see <https://www.gnu.org/licenses/>.
+
+!> @file tblite/scf/observer.f90
+!> Defines the optional observer used by the xtbloom SCC trace oracle.
+
+!> Read-only callbacks around one self-consistent iteration.
+module tblite_scf_observer
+   use mctc_env, only : wp
+   use tblite_scf_potential, only : potential_type
+   use tblite_wavefunction_type, only : wavefunction_type
+   implicit none
+   private
+
+   !> The current iteration satisfied all convergence criteria.
+   integer, parameter, public :: scf_observer_status_converged = 1
+   !> The iteration limit was reached without convergence.
+   integer, parameter, public :: scf_observer_status_max_iterations = 2
+   !> SCC setup or an outer-loop attempt failed.
+   integer, parameter, public :: scf_observer_status_failed = 3
+
+   !> Concrete no-op observer.  Oracle recorders extend this type and
+   !> override one or both callbacks; normal tblite callers omit it.
+   type, public :: scf_observer
+   contains
+      procedure :: before_solve => no_op_before_solve
+      procedure :: after_iteration => no_op_after_iteration
+      procedure :: finished => no_op_finished
+   end type scf_observer
+
+contains
+
+!> Observe the assembled effective Hamiltonian and mixed SCC input.
+!
+! The wavefunction and potential are borrowed only for this callback.  An
+! implementation which needs them later must make a deep copy.  coeff is the
+! assembled Hamiltonian, while qsh/qat/dpat/qpat are the mixed input state.
+subroutine no_op_before_solve(self, iteration, wfn, pot)
+   !> Observer instance
+   class(scf_observer), intent(inout) :: self
+   !> One-based outer-loop attempt number
+   integer, intent(in) :: iteration
+   !> Borrowed pre-solve wavefunction state
+   type(wavefunction_type), intent(in) :: wfn
+   !> Borrowed assembled density-dependent potential
+   type(potential_type), intent(in) :: pot
+end subroutine no_op_before_solve
+
+!> Observe the complete post-solve state and convergence decision.
+!
+! This callback is issued only when next_scf completed without error.  coeff
+! contains orbital coefficients and qsh/qat/dpat/qpat contain the raw Mulliken
+! output.  All objects are borrowed only for the duration of the callback.
+subroutine no_op_after_iteration(self, iteration, wfn, eelec, elast, pnorm, &
+      & econverged, pconverged, tconverged, converged)
+   !> Observer instance
+   class(scf_observer), intent(inout) :: self
+   !> One-based outer-loop attempt number
+   integer, intent(in) :: iteration
+   !> Borrowed post-solve wavefunction state
+   type(wavefunction_type), intent(in) :: wfn
+   !> Per-atom electronic SCC energy for the current state, in Hartree
+   real(wp), intent(in) :: eelec(:)
+   !> Electronic SCC energy from before this attempt, in Hartree
+   real(wp), intent(in) :: elast
+   !> Mixer residual RMS reported by tblite
+   real(wp), intent(in) :: pnorm
+   !> Energy convergence flag
+   logical, intent(in) :: econverged
+   !> Population convergence flag
+   logical, intent(in) :: pconverged
+   !> Electronic-temperature convergence flag
+   logical, intent(in) :: tconverged
+   !> Combined convergence flag
+   logical, intent(in) :: converged
+end subroutine no_op_after_iteration
+
+!> Report the terminal SCC status exactly once after mixer construction.
+!
+! iterations is tblite's final SCC counter.  A mixer failure can report zero;
+! an eigensolver failure can report an iteration for which before_solve ran but
+! after_iteration did not.  No wavefunction payload is exposed on failure.
+subroutine no_op_finished(self, iterations, status)
+   !> Observer instance
+   class(scf_observer), intent(inout) :: self
+   !> Final tblite SCC iteration counter
+   integer, intent(in) :: iterations
+   !> One of the terminal scf_observer_status_* constants
+   integer, intent(in) :: status
+end subroutine no_op_finished
+
+end module tblite_scf_observer
