# Preserve the canonical tblite exporter byte stream, including its final blank line.
data/parameters/gfn2.toml whitespace=-blank-at-eof

# Preserve exact upstream scipy-openblas32 packaged-license bytes. The Windows
# artifacts contain canonical CRLF or mixed line endings verified by SHA-256.
LICENSES/scipy-openblas32-0.3.34.0.0.txt -text
LICENSES/scipy-openblas32-0.3.34.0.0-macos.txt -text
LICENSES/scipy-openblas32-0.3.34.0.0-windows-amd64.txt -text whitespace=cr-at-eol
LICENSES/scipy-openblas32-0.3.34.0.0-windows-arm64.txt -text whitespace=cr-at-eol
LICENSES/scipy-openblas32-tools-LICENSE_win32.txt -text

# These upstream license and vendored-source trees are checked byte-for-byte
# against provenance manifests. Disable checkout newline conversion so a
# Windows worktree retains the same Git object bytes as Linux and macOS.
LICENSES/openchemlib-BSD-3-Clause.txt -text
LICENSES/pyodide-MPL-2.0.txt -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
LICENSES/OpenBLAS-0.3.28-BSD-3-Clause.txt -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
LICENSES/LAPACK-OpenBLAS-0.3.28-BSD-3-Clause.txt -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
LICENSES/CLAPACK-3.2.1-BSD-3-Clause.txt -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
LICENSES/libf2c-AT&T-Lucent-Bellcore.txt -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
LICENSES/eigen/** -text
LICENSES/eigen/** -whitespace
cmake/3rdparty/implib/** -text
cmake/3rdparty/torch-stable/include/** -text
cmake/3rdparty/pyodide-openblas/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab

.git_archival.txt export-subst
