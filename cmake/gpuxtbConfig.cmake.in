@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@GPUXTB_HAS_CUDA@)
  # libgpuxtb.so has no DT_NEEDED entry on the NVIDIA CUDA libraries: the CUDA
  # backend resolves cudart/cuBLAS/cuSOLVER/libcuda lazily through dlopen (see
  # src/runtime/cuda_dlopen.c), so a consumer does not need the CUDA toolkit to
  # link. A compatible major runtime is still required at call time; record the
  # build toolkit as a non-fatal diagnostic instead of a hard dependency.
  find_package(CUDAToolkit QUIET)
  if(CUDAToolkit_FOUND AND NOT CUDAToolkit_VERSION_MAJOR EQUAL @GPUXTB_CUDA_TOOLKIT_MAJOR@)
    message(WARNING
      "gpuxtb was built with CUDA @GPUXTB_CUDA_TOOLKIT_MAJOR@.@GPUXTB_CUDA_TOOLKIT_MINOR@; "
      "found incompatible CUDA ${CUDAToolkit_VERSION}. The CUDA backend loads the "
      "NVIDIA runtime libraries at run time and may fail on this toolkit."
    )
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/gpuxtbTargets.cmake")

check_required_components(gpuxtb)
