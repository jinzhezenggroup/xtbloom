# Copy this file to a run-specific path and edit the copy before submission.
# bin/submit.sh then freezes its exact bytes under PAPER_DATA_ROOT/PAPER_RUN_ID.
# All paths must be absolute.  Do not put datasets or raw outputs in the repo.

export PAPER_PHASE=development                 # development | formal
export PAPER_ALLOW_DIRTY=1                     # formal mode ignores and rejects this
export PAPER_RUN_ID=paper-dev-CHANGE-ME
export PAPER_REPO_ROOT=/absolute/path/to/xtbloom
export PAPER_DATA_ROOT=/absolute/path/to/paper-runs
export PAPER_SOURCE_COMMIT=CHANGE-ME

# Python environment containing numpy and optional dxtb/torch dependencies.
export PAPER_PYTHON=/absolute/path/to/python

# Frozen dataset bundle manifests.  Set these to the canonical CSV files, not
# result JSONL files.  The manifest-freeze job records their complete bundles.
export PAPER_QM9_MAIN_MANIFEST=/absolute/path/to/qm9-main/manifests/selected_samples.csv
# The current 2026-08-20 QM9 bundle has no disjoint 2,048-system performance
# set. Formal manifest freeze intentionally fails until this path is supplied.
export PAPER_QM9_PERFORMANCE_MANIFEST=CHANGE-ME
export PAPER_OMOL25_MANIFEST=/absolute/path/to/omol25/manifests/selected_samples.csv
export PAPER_SELECTION_FILE=${PAPER_DATA_ROOT}/${PAPER_RUN_ID}/freeze-manifests/derived/paper-selection.json

# CPU and CUDA libraries may be the same dual-backend shared object.  Keep
# separate variables so future hardware-specific builds cannot be confused.
export PAPER_CPU_LIBRARY=${PAPER_DATA_ROOT}/${PAPER_RUN_ID}/p0a-canonical-cpu/build/libxtbloom.so
export PAPER_CUDA_LIBRARY=${PAPER_DATA_ROOT}/${PAPER_RUN_ID}/p0a-canonical-gpu/build/libxtbloom.so
export PAPER_XTB_LIBRARY=/absolute/path/to/libxtb.so
export PAPER_XTB_PATH_REGEX='libxtb.so.6.7.1$'
export PAPER_XTB_SHA256=CHANGE-ME
# The current host has tblite 0.4.0 only, while the frozen P0-E protocol calls
# for the reviewed tblite 0.7 runtime.  Formal mode must not substitute it.
export PAPER_TBLITE_LIBRARY=CHANGE-ME
export PAPER_TBLITE_PATH_REGEX='libtblite.so.0.7'
export PAPER_TBLITE_SHA256=CHANGE-ME
export PAPER_DXTB_SOURCE=                         # currently unavailable
export PAPER_DXTB_COMMIT=CHANGE-ME                # full clean source revision
export PAPER_REQUIRE_DXTB=1                       # formal paper matrix
export PAPER_CPU_LINALG_LIBRARY=/absolute/path/to/lp64-lapacke-cblas-provider.so
export PAPER_CPU_LINALG_SHA256=CHANGE-ME
export PAPER_CMAKE=/absolute/path/to/cmake
export PAPER_NINJA=/absolute/path/to/ninja
export PAPER_CUDA_ROOT=/absolute/path/to/cuda
export PAPER_CUDA_COMPILER=/absolute/path/to/nvcc
export PAPER_CUDART_LIBRARY=                   # optional explicit libcudart.so
export PAPER_CUDA_ARCH=auto                       # auto probes allocated GPU

# Scheduler defaults.  Every value is cluster-local and bin/submit.sh records
# the resolved command. PAPER_SBATCH may name a PATH command or an absolute
# notification wrapper supplied by the site.
export PAPER_SBATCH=sbatch
export PAPER_CPU_PARTITION=                    # optional site partition
export PAPER_CPU_HINT=nomultithread
export PAPER_GPU_PARTITION=                    # optional site partition
export PAPER_GPU_GRES=gpu:1
export PAPER_EXPECT_GPU_REGEX=                 # set to a reviewed GPU-name regex
export PAPER_HARDWARE_ID=CHANGE-ME
export PAPER_SECOND_HARDWARE_ID=
export PAPER_SECOND_GPU_REGEX=
export PAPER_SECOND_GPU_PARTITION=
export PAPER_SECOND_GPU_GRES=
export PAPER_SECOND_GPU_CONSTRAINT=
export PAPER_SECOND_CUDA_COMPILER=                    # defaults to PAPER_CUDA_COMPILER
export PAPER_GPU_CONSTRAINT=
export PAPER_DEVICE_ID=0
export PAPER_CPU_SCALING_GOVERNOR=CHANGE-ME       # exact site policy, verified per assigned CPU
export PAPER_NUMACTL=numactl                       # PATH command or absolute path

# Formal computation contract.
export PAPER_MAX_SCC_ITERATIONS=500
export PAPER_ACCURACY=0.0001
export PAPER_ELECTRONIC_TEMPERATURE_K=300
export PAPER_CPU_THREADS=1,4,16,32
export PAPER_CPU_BATCH_SIZES=1,32,128
export PAPER_GPU_BATCH_SIZES=1,4,16,64,256
# Dataset-level heterogeneous resident-batch sweeps cannot exceed the distinct
# real structures in the frozen performance manifests.
export PAPER_QM9_GPU_CAPACITY_BATCH_SIZES=256,512,1024,2048
export PAPER_OMOL25_GPU_CAPACITY_BATCH_SIZES=256,512,1024,2048,4096
export PAPER_AO_BINS=1-64,65-128,129-256,257-512,513-1024,1025-inf
export PAPER_WARMUPS=10
export PAPER_REPETITIONS=30
export PAPER_LONG_REPETITIONS=5
export PAPER_BOOTSTRAP_SAMPLES=10000
export PAPER_SEED=xtbloom-paper-20260821

# Correctness gates from the paper plan; scripts reject attempts to widen them.
export PAPER_ENERGY_ATOL_HARTREE=5e-7
export PAPER_FORCE_ATOL_HARTREE_PER_BOHR=5e-6
export PAPER_CHARGE_ATOL_E=5e-7
export PAPER_CPU_CUDA_ATOL=1e-6
export PAPER_PEER_UNCHANGED_ATOL=1e-10
export PAPER_FD_ATOL_HARTREE_PER_BOHR=1e-5

# Optional conditional SI coordinates.
export PAPER_RUN_WARM_SI=0
export PAPER_TRAJECTORY_MANIFEST=
export PAPER_RUN_SECOND_HARDWARE=0
